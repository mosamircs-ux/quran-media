# ==============================================================================
# Quran Media Platform — Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Database (PostgreSQL via Prisma ORM)
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quran_media?schema=public&connection_limit=20&pool_timeout=10"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/quran_media?schema=public"

# ==============================================================================
# Redis (BullMQ Queues, Caching, and Rate Limiting)
# ==============================================================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_TLS_ENABLED=false

# ==============================================================================
# Official Quran Foundation / Quran.com API (OAuth 2.0 Credentials)
# Server-side ONLY — Never exposed to browser bundle
# ==============================================================================
QURAN_API_BASE_URL="https://api.quran.com/api/v4"
QURAN_OAUTH_TOKEN_URL="https://auth.quran.foundation/oauth2/token"
QURAN_CLIENT_ID="your_quran_foundation_client_id"
QURAN_CLIENT_SECRET="your_quran_foundation_client_secret"
QURAN_API_SCOPE="content"

# ==============================================================================
# S3-Compatible Object Storage (AWS S3, MinIO, Cloudflare R2, DigitalOcean)
# ==============================================================================
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="quran-media"
S3_PUBLIC_DOMAIN="http://localhost:9000/quran-media"
S3_FORCE_PATH_STYLE=true

# ==============================================================================
# AI Provider Abstraction (Configure at least one for generation)
# ==============================================================================
# Default active provider for text/story generation: openai | gemini | anthropic
DEFAULT_TEXT_AI_PROVIDER="openai"
# Default active provider for image generation: openai | replicate | stability | gemini
DEFAULT_IMAGE_AI_PROVIDER="openai"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_ORG_ID=""

# Google Gemini
GOOGLE_AI_KEY="AIzaSy..."

# Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-..."

# Replicate (Flux, SDXL)
REPLICATE_API_TOKEN="r8_..."

# Stability AI (SD3, Core)
STABILITY_API_KEY="sk-..."

# ==============================================================================
# Authentication & Security (NextAuth / JWT / Session)
# ==============================================================================
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-secret-hex-or-base64"
NEXTAUTH_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_PUBLIC_RPM=60
RATE_LIMIT_AUTH_RPM=120
RATE_LIMIT_GEN_RPM=10

# ==============================================================================
# Background Worker Configuration
# ==============================================================================
WORKER_CONCURRENCY=5
WORKER_MAX_STALLED_COUNT=2
WORKER_HEALTH_PORT=3001
FFMPEG_PATH=""
FFPROBE_PATH=""
MEDIA_TEMP_DIR="./tmp/media"

# ==============================================================================
# Logging & Observability
# ==============================================================================
LOG_LEVEL="debug" # trace | debug | info | warn | error | fatal
LOG_PRETTY=true
